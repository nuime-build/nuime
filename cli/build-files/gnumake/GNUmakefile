all: ../../../bin/nuime

../../../bin/nuime: $(_builddir)nuime_CommandLineSpecification.o $(_builddir)nuime_main.o
	@mkdir -p $(dir $@)
	$(CXX) -o $@ $(LDFLAGS) $(_builddir)nuime_CommandLineSpecification.o $(_builddir)nuime_main.o -L$(ISHIKO_CPP_BASEPLATFORM_ROOT)/lib -L$(ISHIKO_CPP_ERRORS_ROOT)/lib -L$(ISHIKO_CPP_UUIDS_ROOT)/lib -L$(ISHIKO_CPP_YAML_CPP_ROOT)/lib -L$(ISHIKO_CPP_TIDYYAML_ROOT)/lib -L$(ISHIKO_CPP_IO_ROOT)/lib -L$(ISHIKO_CPP_BOOST_ROOT)/lib -L$(ISHIKO_CPP_FILESYSTEM_ROOT)/lib -L$(ISHIKO_CPP_FMT_ROOT)/lib -L$(ISHIKO_CPP_MEMORY_ROOT)/lib -L$(ISHIKO_CPP_TEXT_ROOT)/lib -L$(NUIME_BUILDFILES_ROOT)/lib -L$(NUIME_LIB_ROOT)/lib -L$(ISHIKO_CPP_COLOR_ROOT)/lib -L$(ISHIKO_CPP_TYPES_ROOT)/lib -L$(ISHIKO_CPP_TERMINAL_ROOT)/lib -L$(ISHIKO_CPP_CONFIGURATION_ROOT)/lib -lnuime -lnuime_buildfiles -lIshikoTerminal -lIshikoColor -lIshikoConfiguration -lIshikoFileSystem -lIshikoIO -lIshikoUUIDs -lIshikoText -lIshikoErrors -lIshikoBasePlatform -lyaml-cpp -lfmt -lboost_filesystem -pthread

$(_builddir)nuime_CommandLineSpecification.o: ../../src/CommandLineSpecification.cpp
	$(CXX) -c -o $@ $(CPPFLAGS) $(CXXFLAGS) -MD -MP -pthread -DYAML_CPP_STATIC_DEFINE -I$(ISHIKO_CPP_BASEPLATFORM_ROOT)/include -I$(ISHIKO_CPP_ERRORS_ROOT)/include -I$(ISHIKO_CPP_UUIDS_ROOT)/include -I$(ISHIKO_CPP_YAML_CPP_ROOT)/include -I$(ISHIKO_CPP_TIDYYAML_ROOT)/include -I$(ISHIKO_CPP_IO_ROOT)/include -I$(ISHIKO_CPP_BOOST_ROOT)/include -I$(ISHIKO_CPP_FILESYSTEM_ROOT)/include -I$(ISHIKO_CPP_FMT_ROOT)/include -I$(ISHIKO_CPP_MEMORY_ROOT)/include -I$(ISHIKO_CPP_TEXT_ROOT)/include -I$(NUIME_BUILDFILES_ROOT)/include -I$(NUIME_LIB_ROOT)/include -I$(ISHIKO_CPP_COLOR_ROOT)/include -I$(ISHIKO_CPP_TYPES_ROOT)/include -I$(ISHIKO_CPP_TERMINAL_ROOT)/include -I$(ISHIKO_CPP_CONFIGURATION_ROOT)/include -std=c++14 ../../src/CommandLineSpecification.cpp

$(_builddir)nuime_main.o: ../../src/main.cpp
	$(CXX) -c -o $@ $(CPPFLAGS) $(CXXFLAGS) -MD -MP -pthread -DYAML_CPP_STATIC_DEFINE -I$(ISHIKO_CPP_BASEPLATFORM_ROOT)/include -I$(ISHIKO_CPP_ERRORS_ROOT)/include -I$(ISHIKO_CPP_UUIDS_ROOT)/include -I$(ISHIKO_CPP_YAML_CPP_ROOT)/include -I$(ISHIKO_CPP_TIDYYAML_ROOT)/include -I$(ISHIKO_CPP_IO_ROOT)/include -I$(ISHIKO_CPP_BOOST_ROOT)/include -I$(ISHIKO_CPP_FILESYSTEM_ROOT)/include -I$(ISHIKO_CPP_FMT_ROOT)/include -I$(ISHIKO_CPP_MEMORY_ROOT)/include -I$(ISHIKO_CPP_TEXT_ROOT)/include -I$(NUIME_BUILDFILES_ROOT)/include -I$(NUIME_LIB_ROOT)/include -I$(ISHIKO_CPP_COLOR_ROOT)/include -I$(ISHIKO_CPP_TYPES_ROOT)/include -I$(ISHIKO_CPP_TERMINAL_ROOT)/include -I$(ISHIKO_CPP_CONFIGURATION_ROOT)/include -std=c++14 ../../src/main.cpp

clean:
	rm -f $(_builddir)*.o
	rm -f $(_builddir)*.d
