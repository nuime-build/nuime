nuimepath = envvar("NUIME_ROOT");
import $(nuimepath)/nuime/include/Nuime.bkl;
ishikopath = envvar("ISHIKO_CPP_ROOT");
import $(ishikopath)/test-framework/include/Ishiko/TestFramework.bkl;

toolsets = gnu vs2022 vs2019 vs2017;

gnu.makefile = ../gnumake/GNUmakefile;
vs2022.solutionfile = ../vc17/nuime_lib_tests.sln;
vs2019.solutionfile = ../vc16/nuime_lib_tests.sln;
vs2017.solutionfile = ../vc15/nuime_lib_tests.sln;

program nuime_lib_tests : Nuime, IshikoTestFramework
{
    if ($(toolset) == gnu)
    {
        cxx-compiler-options = "-std=c++14";
        libs += nuime nuime_buildfiles IshikoUUIDs IshikoTestFramework IshikoTestFrameworkCore IshikoConfiguration IshikoDiff IshikoXML IshikoFileSystem IshikoIO IshikoProcess IshikoTime IshikoText IshikoErrors IshikoBasePlatform;
        libs += yaml-cpp fmt boost_filesystem;
    }

    if ($(toolset) != gnu)
    {
        archs = x86 x86_64;
        cxx-compiler-options = "/utf-8";
    }

    headers
    {
        ../../src/EngineTests.hpp
    }

    sources
    {
        ../../src/main.cpp
        ../../src/EngineTests.cpp
    }
}
