%YAML 1.2
---
nuime-version: "0.1"
name: example
targets:
  - name: lib
    labels:
      - nuime:code:static-library
    input-groups:
      - labels:
          - nuime:code:cpp-source
        base: sources
        inputs:
          - main.cpp
    output-groups:
      - outputs:
          - example
